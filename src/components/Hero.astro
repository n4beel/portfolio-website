---
import { Github, Linkedin, Mail, Globe } from 'lucide-react';
---

<section class="py-12 md:py-20 animate-slide-up">
  <div class="max-w-3xl">
    <h2 class="text-4xl md:text-6xl font-bold tracking-tight text-secondary mb-6 leading-tight">
      Designing highly scalable, fault-tolerant infrastructure and Money Movement systems.
    </h2>
    <p class="text-lg text-gray-600 leading-relaxed mb-8 max-w-2xl">
      Expertise in NestJS, TypeScript, and Rust on Solana. Bridging Web2 services to Web3 protocols with a focus on distributed data consistency.
    </p>
    
    <div class="flex gap-4">
      <a href="https://github.com/n4beel" target="_blank" rel="noopener noreferrer" 
         class="p-2 text-gray-600 hover:text-primary transition-colors duration-300 bg-gray-50 rounded-full hover:bg-gray-100">
        <Github size={20} />
      </a>
      <a href="https://linkedin.com/in/nabeel-a-khan" target="_blank" rel="noopener noreferrer"
         class="p-2 text-gray-600 hover:text-primary transition-colors duration-300 bg-gray-50 rounded-full hover:bg-gray-100">
        <Linkedin size={20} />
      </a>
      <a href="mailto:contact@nabeelkhan.dev"
         class="p-2 text-gray-600 hover:text-primary transition-colors duration-300 bg-gray-50 rounded-full hover:bg-gray-100">
        <Mail size={20} />
      </a>
      <a href="https://nabeelkhan.dev" target="_blank" rel="noopener noreferrer"
         class="p-2 text-gray-600 hover:text-primary transition-colors duration-300 bg-gray-50 rounded-full hover:bg-gray-100">
        <Globe size={20} />
      </a>
    </div>
  </div>
</section>
