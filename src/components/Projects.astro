---
import FeaturedProjects from "./FeaturedProjects.jsx";
import projects from "../data/projects.json";
---

<section id="projects" class="py-20">
  <div class="mb-12">
    <p class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
      Case Studies
    </p>
    <h3 class="text-2xl md:text-3xl font-bold text-secondary tracking-tight">
      Enterprise-grade systems across domains
    </h3>
  </div>
  <FeaturedProjects client:load allProjects={projects} />
</section>
