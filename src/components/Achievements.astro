---
import { ExternalLink } from "lucide-react";

const achievements = [
    {
        title: "Runner up in ST PAK | Local Track for Colosseum Breakout Hackathon",
        link: "https://earn.superteam.fun/listing/st-pak-local-track",
    },
    {
        title: "Winner in Write a Twitter thread contrasting DePIN with centralized players",
        link: "https://earn.superteam.fun/listing/write-a-twitter-thread-contrasting-depin-with-centralized-players",
    },
    {
        title: "Honorable Mentions in LayerZero Solana Bounty",
        link: "https://earn.superteam.fun/listing/layerzero-solana-breakout-track",
    },
];
---

<section id="achievements" class="mb-16">
    <h2 class="text-2xl font-semibold text-gray-900 mb-8">Achievements</h2>
    <div class="space-y-6">
        {
            achievements.map((achievement) => (
                <a
                    href={achievement.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group block relative pl-8 border-l border-gray-200 hover:border-gray-400 transition-colors duration-300"
                >
                    <div class="absolute -left-[5px] top-2 w-2.5 h-2.5 rounded-full bg-gray-300 ring-4 ring-white group-hover:bg-gray-500 transition-colors duration-300" />
                    <div class="flex items-start justify-between gap-4">
                        <h3 class="text-lg font-medium text-gray-900 group-hover:text-primary transition-colors duration-300">
                            {achievement.title}
                        </h3>
                        <ExternalLink
                            size={18}
                            className="text-gray-400 group-hover:text-primary transition-colors duration-300 shrink-0 mt-1"
                        />
                    </div>
                </a>
            ))
        }
    </div>
</section>
