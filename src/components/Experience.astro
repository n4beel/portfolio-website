---
const experiences = [
  {
    company: "BlockApex",
    role: "Senior Software Engineer & Technical Lead",
    period: "Mar 2023 -- Feb 2026",
    location: "Karachi, PK",
    description:
      "Lead Architect for internal security engines and high-scale client infrastructure. I oversee the engineering lifecycle for complex distributed systems, bridging high-concurrency Web2 services (NestJS/Redis) with cryptographic security protocols (Rust). A key initiative involved overhauling the organization's DevOps culture, replacing ad-hoc deploys with standardized CI/CD pipelines across 8 distinct architectures.",
    metrics: ["Distributed Systems", "CI/CD Standardization"],
    tech: ["Rust", "Solana", "NestJS", "AWS"],
  },
  {
    company: "Xord",
    role: "Full Stack Blockchain Engineer",
    period: "May 2022 -- Mar 2023",
    location: "Karachi, PK",
    description:
      "Architected end-to-end backend infrastructure for decentralized media platforms. My role focused on performance engineering; I profiled and rewrote complex PostgreSQL aggregation pipelines for a blockchain explorer, using execution-plan analysis and materialized views to cut API query latency. Additionally, I led the design of secure, non-custodial authentication flows for enterprise applications.",
    metrics: ["Query Optimization", "System Performance"],
    tech: ["Solidity", "Node.js", "PostgreSQL"],
  },
  {
    company: "Tezeract",
    role: "Co-Founder & CTO",
    period: "Dec 2020 -- May 2022",
    location: "Karachi, PK",
    description:
      "As Co-Founder, I led engineering strategy and mentored a team of 4 developers while personally architecting and building the company's AI products: Formole, a venture-backed soccer coaching app that analyses a kick with pose estimation; Spintip, automated tennis highlight generation from raw match footage; Navex, face-recognition attendance for school buses built to run offline; MapApp, a wildfire exposure assessment tool over national geospatial data; and Duckends, gesture-based feedback capture. I also engineered financial integrations for an OTA platform processing $50k+ in monthly volume.",
    metrics: ["Applied Computer Vision", "Engineering Leadership"],
    tech: ["Python", "TensorFlow", "Computer Vision", "Geospatial", "AWS"],
  },
  {
    company: "Xehen",
    role: "Lead MERN Stack Engineer",
    period: "May 2020 -- Dec 2020",
    location: "Karachi, PK",
    description:
      "Led a backend engineering team to establish robust REST API standards and scalable database schemas. My architectural decisions laid the foundation for the platform to scale to 5,000+ active users, ensuring data consistency and query performance during the product's early growth phase.",
    metrics: ["API Standards", "Scalable Schema Design"],
    tech: ["MongoDB", "Express", "React", "Node.js"],
  },
  {
    company: "Edgeon Solutions",
    role: "Frontend Developer",
    period: "Jun 2019 -- May 2020",
    location: "Karachi, PK",
    description:
      "Focused on high-performance frontend architecture and state management. I collaborated closely with backend teams to design efficient API contracts and data synchronization patterns, ensuring seamless integration between complex user interfaces and server-side logic.",
    metrics: ["Client-Server Arch", "API Integration"],
    tech: ["React", "Redux", "JavaScript", "HTML/CSS"],
  },
];
---

<section id="experience" class="py-20">
  <h3
    class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-12"
  >
    Experience
  </h3>
  <div class="space-y-12">
    {
      experiences.map((exp) => (
        <div class="group relative border-l-2 border-gray-200 pl-8 pb-2 hover:border-primary transition-colors duration-300">
          <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-gray-200 group-hover:bg-primary transition-colors duration-300 ring-4 ring-white" />

          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-2">
            <h4 class="text-xl font-bold text-secondary group-hover:text-primary transition-colors">
              {exp.company}
            </h4>
            <span class="text-sm text-gray-500 font-mono">{exp.period}</span>
          </div>

          <div class="mb-4">
            <span class="text-lg text-gray-700 font-medium">{exp.role}</span>
            <span class="text-gray-500 text-sm ml-2">• {exp.location}</span>
          </div>

          <p class="text-gray-600 mb-4 leading-relaxed max-w-2xl">
            {exp.description}
          </p>

          <div class="flex flex-wrap gap-3 mb-4">
            {exp.metrics.map((metric) => (
              <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 border border-green-100">
                {metric}
              </span>
            ))}
          </div>

          <div class="flex flex-wrap gap-2">
            {exp.tech.map((tech) => (
              <span class="px-2 py-1 text-xs font-mono text-gray-500 bg-gray-50 border border-gray-100 rounded hover:border-gray-300 transition-colors cursor-default">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
