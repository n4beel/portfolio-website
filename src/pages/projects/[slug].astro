---
import Layout from "../../layouts/Layout.astro";
import projects from "../../data/projects.json";

export function getStaticPaths() {
    return projects.map((project) => ({
        params: { slug: project.slug },
    }));
}

const { slug } = Astro.params;
const project = projects.find((item) => item.slug === slug);

if (!project) {
    return Astro.redirect("/projects");
}
---

<Layout
    title={`${project.project_name} | Case Study`}
    description={project.project_tagline}
>
    <main class="max-w-4xl mx-auto px-6 md:px-12 pt-20 pb-24">
        <a
            href="/projects"
            class="text-sm font-semibold text-primary hover:text-primary/80"
        >
            ← Back to Archive
        </a>

        <section
            class="mt-6 rounded-3xl border border-gray-100 bg-white p-8 shadow-sm"
        >
            <div class="flex flex-wrap items-center gap-3">
                <span
                    class="text-xs font-semibold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full"
                >
                    {project.domain_context}
                </span>
                <span
                    class="text-xs font-semibold uppercase tracking-wider text-gray-500"
                >
                    Case Study
                </span>
            </div>

            <h1 class="mt-4 text-3xl md:text-4xl font-bold text-secondary">
                {project.project_name}
            </h1>
            <p class="mt-3 text-gray-600 leading-relaxed">
                {project.project_tagline}
            </p>

            {
                project.role_note && (
                    <p class="mt-4 border-l-2 border-primary/30 pl-4 text-sm text-gray-500">
                        {project.role_note}
                    </p>
                )
            }

            <div class="mt-6 flex flex-wrap gap-2">
                {
                    project.tech_stack.map((tech) => (
                        <span class="rounded-full border border-gray-100 bg-gray-50 px-3 py-1 text-xs font-medium text-gray-600">
                            {tech}
                        </span>
                    ))
                }
            </div>

            {
                (project.live_url || project.repo_url) && (
                    <div class="mt-6 flex flex-wrap gap-3">
                        {project.live_url && (
                            <a
                                href={project.live_url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 rounded-full bg-secondary px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-primary"
                            >
                                Read complete case study ↗
                            </a>
                        )}
                        {project.repo_url && (
                            <a
                                href={project.repo_url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-secondary transition-colors hover:border-primary/40 hover:text-primary"
                            >
                                View Source ↗
                            </a>
                        )}
                    </div>
                )
            }
        </section>

        <section class="mt-10">
            <h2 class="text-xl font-bold text-secondary">
                Architecture Overview
            </h2>
            <p class="mt-3 text-gray-600 leading-relaxed">
                {project.architecture_overview}
            </p>
        </section>

        <section class="mt-10">
            <h2 class="text-xl font-bold text-secondary">The Challenges</h2>
            <div class="mt-6 space-y-6">
                {
                    project.key_challenges.map((challenge) => (
                        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-semibold uppercase tracking-wider text-primary bg-primary/10 px-2 py-1 rounded-full">
                                    {challenge.focus}
                                </span>
                            </div>
                            <div class="mt-4 grid gap-6 md:grid-cols-2">
                                <div>
                                    <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">
                                        Problem
                                    </h3>
                                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                                        {challenge.challenge}
                                    </p>
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">
                                        Solution
                                    </h3>
                                    <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                                        {challenge.solution}
                                    </p>
                                </div>
                            </div>
                            {challenge.evidence && (
                                <p class="mt-4 border-t border-gray-100 pt-3 font-mono text-xs text-gray-400">
                                    {challenge.evidence}
                                </p>
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>
