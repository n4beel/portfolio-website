---
import Layout from "../../layouts/Layout.astro";
import ProjectArchive from "../../components/ProjectArchive.jsx";
import projects from "../../data/projects.json";
---

<Layout title="Engineering Archive | Nabeel Ahmed Khan">
    <main class="max-w-6xl mx-auto px-6 md:px-12 pt-20 pb-24">
        <div class="mb-10">
            <a
                href="/"
                class="text-sm font-semibold text-primary hover:text-primary/80"
            >
                ← Back to Home
            </a>
            <h1 class="mt-4 text-3xl md:text-4xl font-bold text-secondary">
                Engineering Archive
            </h1>
            <p class="mt-3 text-gray-600 max-w-3xl">
                Explore the complete set of case studies across exchanges,
                fintech, security, and compliance systems. Filter by domain,
                tech stack, or keywords to find the most relevant architecture
                work.
            </p>
        </div>

        <ProjectArchive projects={projects} client:load />
    </main>
</Layout>
